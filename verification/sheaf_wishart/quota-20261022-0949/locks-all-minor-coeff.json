    "JinWishart.gram_polynomial_coefficient_re_eq_sum_normSq_minors": "{m n : ℕ} (X : Matrix (Fin m) (Fin n) ℂ) (q : ℕ) : ((((1+(Polynomial.X : ℂ[X]) • (complexGram X).map Polynomial.C).det).coeff q)).re = ∑ T : {T : Finset (Fin n) // T.card = q}, ∑ S : {S : Finset (Fin m) // S.card = q}, Complex.normSq ((X.submatrix (fun i => (cardinalSubsetEnumeration S i).val) (fun j => (cardinalSubsetEnumeration T j).val)).det)"
