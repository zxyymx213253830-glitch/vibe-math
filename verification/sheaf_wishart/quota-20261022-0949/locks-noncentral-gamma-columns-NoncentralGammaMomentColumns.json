  "source": "theory/jin_wishart_formalization/JinWishartFormalization/NoncentralGammaMomentColumns.lean",
  "statements": {
    "JinWishart.noncentralMomentPolynomial_coeff": "(q k j : ℕ) : (noncentralMomentPolynomial q k).coeff j = (k.factorial : ℝ)*((q+k).choose (q+j) : ℝ)/(j.factorial : ℝ)",
    "JinWishart.noncentralMomentPolynomial_weighted_coeff": "(q k j : ℕ) : ((q+j).factorial : ℝ)*(noncentralMomentPolynomial q k).coeff j = ((q+k).factorial : ℝ)*(k.choose j : ℝ)",
    "JinWishart.gammaMoment_column_eq_coefficient_sum": "(q k h : ℕ) : (∑ j ∈ range (h+1), (h.factorial : ℝ)*((q+h).choose (h-j) : ℝ)* ((q+j).factorial : ℝ)*(noncentralMomentPolynomial q k).coeff j) = ((q+k+h).factorial : ℝ)",
    "JinWishart.gammaMomentColumnTransform_det": "(q p : ℕ) : (gammaMomentColumnTransform q p).det = ∏ h : Fin p, (h.val.factorial : ℝ)*((q+h.val).factorial : ℝ)",
    "JinWishart.gammaMomentColumnTransform_det_ne_zero": "(q p : ℕ) : (gammaMomentColumnTransform q p).det ≠ 0"
  },
