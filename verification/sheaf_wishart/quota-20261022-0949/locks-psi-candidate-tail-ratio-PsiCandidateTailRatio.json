  "statements": {
    "JinWishart.norm_det_submatrix_equiv_equiv_complex": "{a b : Type*} [Fintype a] [Fintype b] [DecidableEq a] [DecidableEq b] (er ec : a ≃ b) (A : Matrix b b ℂ) : ‖(A.submatrix er ec).det‖ = ‖A.det‖",
    "JinWishart.mixedCandidateTailMatrix_det_eq_restricted": "(p L q : ℕ) (lambda : Fin L → ℝ) (x : ℝ) (hx : 0 ≤ x) : (mixedCandidateTailMatrix p L q lambda x).det = (Matrix.of (fun i j => ∫ y in Ioi x, mixedEnsembleF p L i y * mixedEnsembleG p L q lambda j y ∂(volume.restrict (Ioi (0 : ℝ))))).det",
    "JinWishart.paperPsi_tail_det_norm": "(p L q : ℕ) (lambda : Fin L → ℝ) (hl : ∀ j, 0 ≤ lambda j) (x : ℝ) (hx : 0 ≤ x) : ‖(theorem1PsiMatrix (p+L) (p+L+q) L (by omega) (by omega) lambda x).det‖ = (∏ j : Fin p ⊕ Fin L, psiTailColumnFactor p L q lambda j) * |(mixedCandidateTailMatrix p L q lambda x).det|",
    "JinWishart.mixedCandidateTailMatrix_zero_det": "(p L q : ℕ) (lambda : Fin L → ℝ) : (mixedCandidateTailMatrix p L q lambda 0).det = (determinantMomentMatrix (volume.restrict (Ioi (0 : ℝ))) (mixedEnsembleF p L) (mixedEnsembleG p L q lambda)).det",
    "JinWishart.mixedCandidateTailMatrix_det_nonneg": "(p L q : ℕ) (lambda : Fin L → ℝ) (hl : StrictMono lambda) (hlp : ∀ j, 0 < lambda j) (x : ℝ) (hx : 0 ≤ x) : 0 ≤ (mixedCandidateTailMatrix p L q lambda x).det",
    "JinWishart.mixedCandidateEnsemble_all_gt_eq_paperPsi_ratio": "(p L q : ℕ) (lambda : Fin L → ℝ) (hl : StrictMono lambda) (hlp : ∀ j, 0 < lambda j) (x : ℝ) (hx : 0 ≤ x) : ((mixedCandidateEnsemble p L q lambda) {z | ∀ i, x < z i}).toReal = ‖(theorem1PsiMatrix (p+L) (p+L+q) L (by omega) (by omega) lambda x).det‖ / ‖(theorem1PsiMatrix (p+L) (p+L+q) L (by omega) (by omega) lambda 0).det‖"
  },
