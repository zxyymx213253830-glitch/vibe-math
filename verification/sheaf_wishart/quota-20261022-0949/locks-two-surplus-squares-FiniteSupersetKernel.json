    "JinWishart.finiteSupersetKernel_sum": "(n : ℕ) (U : Finset (Fin n)) : (∑ R : Finset (Fin n), if U⊆R then 1/(((n+1 : ℕ) : ℝ)*(n.choose R.card : ℝ)) else 0) = 1/((U.card+1 : ℕ) : ℝ)",
    "JinWishart.finiteSubsetPairKernel_square_sum": "(n : ℕ) (f : Finset (Fin n) → ℝ) : (∑ U : Finset (Fin n), ∑ V : Finset (Fin n), f U*f V/(((U ∪ V).card+1 : ℕ) : ℝ)) = ∑ R : Finset (Fin n), (∑ U ∈ R.powerset,f U)^2/ (((n+1 : ℕ) : ℝ)*(n.choose R.card : ℝ))"
  },
